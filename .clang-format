---
Language: Cpp
BasedOnStyle: LLVM

# Embedded C style used by this project.
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100

# Keep the existing C-style brace layout consistent.
BreakBeforeBraces: Allman

# Avoid changing hardware-driver include ordering implicitly.
SortIncludes: false
IncludeBlocks: Preserve

# Keep pointer/reference spelling compact and common in C code.
PointerAlignment: Right

# Make control-flow formatting explicit and stable.
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# Improve readability of function calls and declarations.
AlignAfterOpenBracket: Align
BinPackArguments: false
BinPackParameters: false

# Keep macros readable without trying to realign every legacy define table.
AlignConsecutiveMacros: false
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false

# C comments are common in this codebase; do not aggressively reflow them.
ReflowComments: false
